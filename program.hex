// program.hex - simple add test
// x1 = 5, x2 = 10, x3 = x1 + x2 = 15
// Load with: $readmemh("program.hex", imem);
00500093  // addi x1, x0, 5    -> x1 = 5
00A00113  // addi x2, x0, 10   -> x2 = 10
002081B3  // add  x3, x1, x2   -> x3 = 15  <-- the result to check
0000006F  // jal  x0, 0        -> infinite self-loop (halt)
